# Copy to .env.local and fill in. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Project Settings > Database > Connection string) ---
# Session pooler (port 5432). Used by Prisma at runtime in local dev.
DATABASE_URL=
# Same session pooler URL (or direct connection if you have IPv6). Used by Prisma migrations.
DIRECT_URL=
# Local stand-in for the HYPERDRIVE binding during `next dev` / `npm run preview`.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# --- Store ---
# Display-only COP->USD rate until it moves to the Setting table (phase 2a).
NEXT_PUBLIC_DEFAULT_USD_RATE=4000
