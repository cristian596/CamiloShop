# Copy to .env.local and fill in. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Project Settings > Database > Connection string) ---
# Session pooler (port 5432). Used by Prisma at runtime in local dev.
DATABASE_URL=
# Same session pooler URL (or direct connection if you have IPv6). Used by Prisma migrations.
DIRECT_URL=
# Local stand-in for the HYPERDRIVE binding during `next dev` / `npm run preview`.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# --- Store ---
# Display-only COP->USD rate until it moves to the Setting table (phase 2a).
NEXT_PUBLIC_DEFAULT_USD_RATE=4000

# --- Auth ---
# false: sign-up confirms the email automatically (Admin API). Use it while Resend
# has no verified domain. true: Supabase sends a confirmation link.
REQUIRE_EMAIL_VERIFICATION=false
# Random string (>= 16 chars) used to hash client IPs for rate limiting.
RATE_LIMIT_SALT=
# Shared demo customer for the "Entrar como demo" button (created by npm run db:seed).
DEMO_USER_EMAIL=demo.camiloshop@example.com
DEMO_USER_PASSWORD=

# --- Email (Resend) ---
RESEND_API_KEY=
# Without a verified domain, onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM="CamiloShop <onboarding@resend.dev>"

# --- Orders ---
# Minutes an unpaid card/PSE order keeps its stock reserved (pg_cron cancels it after).
ORDER_EXPIRY_MINUTES=30
# Minutes a cash-on-delivery order waits for the admin to confirm it.
COD_ORDER_EXPIRY_MINUTES=2880
