// CamiloShop data model.
//
// Conventions:
// - Money is stored as integer COP (pesos, no decimals). Every price includes 19% VAT.
// - Catalog copy is bilingual through *Es / *En columns (the store has two fixed locales).
// - Row Level Security, CHECK constraints and extensions live in hand-written SQL inside
//   the migrations, because Prisma cannot express them (see docs/decisions.md).
//
// OpenNext patches the generated client for workerd, which only works with the
// default output location of `prisma-client-js` (see docs/decisions.md).

generator client {
  provider      = "prisma-client-js"
  // Smaller WASM query compiler: keeps the Worker under the Free plan limit.
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  PSE
  COD
}

enum PaymentProvider {
  WOMPI
  COD
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

enum CouponType {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

/// One row per Supabase auth user; `id` equals auth.users.id (FK added in phase 3).
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  phone     String?
  role      Role     @default(CUSTOMER)
  locale    String   @default("es")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  questions   Question[]
  answers     Answer[]
  favorites   Favorite[]
  redemptions CouponRedemption[]
  statusEdits OrderStatusHistory[]
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String
  recipient  String
  phone      String
  department String
  city       String
  line1      String
  line2      String?
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  nameEs   String
  nameEn   String
  parentId String? @db.Uuid
  position Int     @default(0)
  imageUrl String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String

  products Product[]
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  nameEs         String
  nameEn         String
  descriptionEs  String
  descriptionEn  String
  categoryId     String   @db.Uuid
  brandId        String   @db.Uuid
  /// Base price in COP, VAT included. Variants may override it.
  price          Int
  compareAtPrice Int?
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  soldCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category  Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images    ProductImage[]
  variants  ProductVariant[]
  reviews   Review[]
  questions Question[]
  favorites Favorite[]

  @@index([categoryId, isActive])
  @@index([brandId])
  @@index([price])
  @@index([isFeatured])
}

model ProductImage {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @db.Uuid
  url         String
  altEs       String
  altEn       String
  position    Int     @default(0)
  /// Set when the file lives in Supabase Storage (admin uploads).
  storagePath String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @db.Uuid
  sku           String  @unique
  /// Free-form size label ("M", "42", "128 GB", "50 ml"); null when not applicable.
  size          String?
  /// Color key translated in messages (Colors.*); null when not applicable.
  color         String?
  colorHex      String?
  priceOverride Int?
  /// Never negative: enforced by a CHECK constraint in SQL.
  stock         Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@index([size])
  @@index([color])
}

// ---------------------------------------------------------------------------
// Orders and payments
// ---------------------------------------------------------------------------

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  /// Human-readable number, e.g. CS-2026-000123.
  number          String        @unique
  userId          String        @db.Uuid
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  subtotal        Int
  discount        Int           @default(0)
  shippingCost    Int
  taxBase         Int
  taxAmount       Int
  total           Int
  couponCode      String?
  /// Address snapshot at purchase time.
  shippingAddress Json
  termsAcceptedAt DateTime
  termsVersion    String
  expiresAt       DateTime?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          Profile              @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  redemption    CouponRedemption?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  variantId   String  @db.Uuid
  productName String
  size        String?
  color       String?
  imageUrl    String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  from        OrderStatus?
  to          OrderStatus
  changedById String?      @db.Uuid
  note        String?
  createdAt   DateTime     @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy Profile? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @db.Uuid
  provider      PaymentProvider
  /// One reference per payment attempt, e.g. CS-2026-000123-A2.
  reference     String          @unique
  providerTxId  String?         @unique
  method        PaymentMethod?
  status        PaymentStatus   @default(PENDING)
  amountInCents BigInt
  raw           Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Idempotency log for payment provider webhooks.
model WebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventKey    String          @unique
  payload     Json
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
}

model Coupon {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  type        CouponType
  value       Int
  isActive    Boolean    @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int?
  usedCount   Int        @default(0)
  minSubtotal Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @db.Uuid
  orderId   String   @unique @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  coupon Coupon  @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model ShippingRate {
  id         String @id @default(uuid()) @db.Uuid
  department String
  /// City name, or "DEFAULT" for every city without its own rate.
  city       String @unique
  price      Int
  etaDays    Int
}

/// Key-value store settings (usdRate, freeShippingThreshold, taxRate).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Social
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  title     String?
  body      String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId, createdAt])
}

model Question {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model Answer {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  userId     String   @db.Uuid
  body       String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Favorite {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

/// Rate limiting for actions without a session (keyed by a salted IP hash) or per user.
model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  key       String
  action    String
  createdAt DateTime @default(now())

  @@index([key, action, createdAt])
}
