{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camiloshop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "camiloshop",
    },
  ],
  // Create it with: npx wrangler hyperdrive create camiloshop-db --connection-string="<Supabase session pooler URL>"
  // Locally, wrangler reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (see .env.example).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "77b6567dc5274ad08cbd41f6563b7ce7",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
